DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp

# Obligatorio: development | production | test
NODE_ENV=development
DB_SYNCHRONIZE=false  # el esquema lo define public/db/01-init.sql
DB_LOGGING=true       # ver las queries SQL en consola
DB_SSL=false          # true para bases gestionadas en la nube

PORT=3000

# CORS: orígenes permitidos separados por comas.
# Se normalizan solos: minúsculas y sin barra final.
# prod: CORS_ORIGINS=https://app.komi.com,https://www.komi.com
# '*' abre la API a cualquier origen y la app NO arranca con NODE_ENV=production
CORS_ORIGINS=http://localhost:3000

# Solo 'true' o 'false' literales. Ausente => true
CORS_CREDENTIALS=true

# Segundos que el navegador cachea el preflight (Chrome lo capa a 7200)
CORS_MAX_AGE=86400


# --- JWT ---
# Genera el tuyo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAME_por_un_secreto_de_verdad_de_minimo_32_caracteres
# Vida del access token en segundos (900 = 15 min)
JWT_ACCESS_TTL=900
# Dias que vive la sesion / refresh token
JWT_REFRESH_TTL_DAYS=7
