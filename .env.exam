DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp

# Obligatorio: development | production | test
NODE_ENV=development
DB_SYNCHRONIZE=false  # el esquema lo define public/db/01-init.sql
DB_LOGGING=true       # emitir las queries SQL al log (salen en nivel debug)
DB_SSL=false          # true para bases gestionadas en la nube

PORT=3000

# Nivel minimo de log. Opcional: sin definir, development => debug,
# production => info, test => silent.
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Salida coloreada y legible (pino-pretty) en vez de JSON.
# Ausente => true fuera de produccion. En produccion se ignora: siempre JSON.
LOG_PRETTY=true

# Registrar el cuerpo, la query y los parametros de cada peticion, con los
# campos sensibles (password, token, cookie...) ocultos. Sirve para APAGARLO en
# desarrollo cuando se trabaja con datos reales; en produccion NUNCA se activa,
# diga lo que diga esta variable.
LOG_REQUEST_PAYLOAD=true

# CORS: orígenes permitidos separados por comas.
# Se normalizan solos: minúsculas y sin barra final.
# prod: CORS_ORIGINS=https://app.komi.com,https://www.komi.com
# '*' abre la API a cualquier origen y la app NO arranca con NODE_ENV=production
CORS_ORIGINS=http://localhost:3000

# Solo 'true' o 'false' literales. Ausente => true
CORS_CREDENTIALS=true

# Segundos que el navegador cachea el preflight (Chrome lo capa a 7200)
CORS_MAX_AGE=86400


# --- JWT ---
# Genera el tuyo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAME_por_un_secreto_de_verdad_de_minimo_32_caracteres
# Vida del access token en segundos (900 = 15 min)
JWT_ACCESS_TTL=900
# Dias que vive la sesion / refresh token
JWT_REFRESH_TTL_DAYS=7
