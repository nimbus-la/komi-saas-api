# Entorno en el que corre la aplicación. Puede ser development, production o test
NODE_ENV=development

PORT=3000


# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp

# Ponla en true solo si la base está en un servicio en la nube que exige conexión cifrada
DB_SSL=false


# Direcciones del frontend que pueden llamar a la API, separadas por comas.
# Al desarrollar, localhost se permite en cualquier puerto aunque no esté aquí.
# En producción va la dirección real del frontend, por ejemplo https://app.komi.com
# El asterisco no se admite, porque la sesión viaja en cookies
CORS_ORIGINS=http://localhost:3000


# Clave con la que se firman los tokens, de al menos 32 caracteres.
# El README explica cómo generar una segura
JWT_SECRET=CAMBIAME_por_un_secreto_de_verdad_de_minimo_32_caracteres

# Duración del token de acceso en segundos, 900 son 15 minutos
JWT_ACCESS_TTL=900

# Días que dura la sesión antes de pedir otro inicio de sesión
JWT_REFRESH_TTL_DAYS=7


# Nivel mínimo del log. Si no se define, en desarrollo es debug, en producción info
# y en pruebas silent. Los niveles son fatal, error, warn, info, debug, trace y silent
LOG_LEVEL=debug

# Guarda en el log el cuerpo de cada petición con los datos sensibles ocultos.
# Ponla en false si desarrollas con datos reales. En producción nunca se activa
LOG_REQUEST_PAYLOAD=true
